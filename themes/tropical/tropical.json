{
  "$schema": "../theme.schema.json",
  "schemaVersion": 1,
  "name": "tropical",
  "kind": "light",
  "loader": "pulse",
  "colors": {
    "background": "#F0EEE6",
    "surface": "#F4F3EE",
    "surface-raised": "#FFFFFF",
    "text": "#191919",
    "muted": "#67625A",
    "border": "#DCD7C9",
    "border-strong": "#C7C0AE",
    "accent": "#D97757",
    "accent-fg": "#191919",
    "link": "#3D6A95",
    "code-bg": "#E9E5DA",
    "code-fg": "#1F1E1D",
    "quote": "#5F5A51",
    "danger": "#A8452A",
    "warning": "#7A5A12",
    "success": "#4C6B3C",
    "info": "#3D6A95",
    "selection": "#E8DFCB"
  },
  "radii": {
    "none": 0,
    "sm": 6,
    "md": 8,
    "lg": 10,
    "xl": 14,
    "pill": 999,
    "circle": 9999
  },
  "typography": {
    "family": "Styrene B",
    "stack": "\"Styrene B\", \"Styrene A\", \"Söhne\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
    "mono-stack": "\"Berkeley Mono\", \"Söhne Mono\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "base-size": 17,
    "ui-size": 13,
    "small-size": 11.5,
    "line-height": 1.65,
    "heading-line-height": 1.25,
    "code-line-height": 1.55,
    "weight-normal": 400,
    "weight-bold": 600
  },
  "layout": {
    "content-width": "46rem",
    "sidebar-width": "16rem",
    "scroll-offset": "7rem",
    "article-padding-y": "2.5rem",
    "article-padding-x": "1.25rem",
    "article-padding-bottom": "6rem",
    "control-height": "1.9rem",
    "code-padding": "1em",
    "table-cell-padding": ".4em .75em"
  },
  "effects": {
    "shadow-panel": "0 8px 28px rgba(25,25,25,.12)",
    "overlay": "rgba(25,25,25,.42)",
    "blur": "10px",
    "duration-fast": ".15s",
    "duration-ui": ".2s",
    "easing": "cubic-bezier(.2,.7,.3,1)"
  },
  "charts": {
    "palette": [
      "#D97757",
      "#3D6A95",
      "#8A9A5B",
      "#CC785C",
      "#D4A27F",
      "#BD5D3A",
      "#6E8B9E",
      "#5F5A51"
    ]
  },
  "shiki": {
    "light": "tropical",
    "dark": "tropical"
  },
