{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-preview.local/theme.schema.json",
  "title": "md-preview theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "$ref": "#/$defs/themeName"
    },
    "kind": {
      "enum": ["auto", "light", "dark"]
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": {
          "$ref": "#/$defs/themeName"
        },
        "dark": {
          "$ref": "#/$defs/themeName"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "fg", "muted", "link", "border", "code-bg", "quote"],
      "properties": {
        "bg": {
          "$ref": "#/$defs/color"
        },
        "fg": {
          "$ref": "#/$defs/color"
        },
        "muted": {
          "$ref": "#/$defs/color"
        },
        "link": {
          "$ref": "#/$defs/color"
        },
        "border": {
          "$ref": "#/$defs/color"
        },
        "code-bg": {
          "$ref": "#/$defs/color"
        },
        "quote": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "shiki": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light", "dark"],
      "properties": {
        "light": {
          "type": "string",
          "minLength": 1
        },
        "dark": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "mermaid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme", "overrides"],
      "properties": {
        "theme": {
          "enum": ["default", "neutral", "dark", "forest", "base"]
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "auto"
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["variants"],
        "not": {
          "anyOf": [{ "required": ["tokens"] }, { "required": ["shiki"] }, { "required": ["mermaid"] }]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": ["light", "dark"]
          }
        },
        "required": ["kind"]
      },
      "then": {
        "required": ["tokens", "shiki", "mermaid"],
        "not": {
          "required": ["variants"]
        }
      }
    }
  ],
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "themeName": {
      "type": "string",
      "minLength": 1
    }
  }
}
