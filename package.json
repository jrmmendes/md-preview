{
  "name": "md-preview",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "bin": {
    "md-preview": "./bin/md-preview"
  },
  "files": [
    "bin/",
    "themes/",
    "dist/client/",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:client": "bun run build.ts --client-only",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@shikijs/langs": "3.23.0",
    "@shikijs/themes": "3.23.0",
    "commander": "15.0.0",
    "markdown-it": "14.3.2",
    "markdown-it-anchor": "9.2.1",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mermaid": "12.2.0",
    "shiki": "3.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "5.9.3"
  },
  "trustedDependencies": []
}
