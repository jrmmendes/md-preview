{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://md-preview.local/emoji.schema.json",
  "title": "md-preview emoji pack",
  "description": "Pacote de shortcodes de emoji (schemaVersion 1). O validador de runtime em src/core/emoji/validate.ts é autoritativo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "shortcodes"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "description": "Deve ser igual ao nome do arquivo sem .json."
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "style": {
      "enum": ["twemoji", "noto", "native"],
      "default": "native"
    },
    "shortcodes": {
      "type": "object",
      "maxProperties": 2000,
      "propertyNames": {
        "pattern": "^(x|[a-z0-9_+-]{2,64})$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^data:image/svg\\+xml;base64,[A-Za-z0-9+/]+={0,2}$",
            "maxLength": 45000,
            "description": "SVG inline em base64 (até 32 KiB decodificados)."
          },
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^\\S+$",
            "description": "Sequência Unicode de 1 a 8 code points."
          }
        ]
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "attribution": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  }
}
