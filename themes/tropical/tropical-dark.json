{
  "$schema": "../theme.schema.json",
  "schemaVersion": 1,
  "name": "tropical-dark",
  "kind": "dark",
  "loader": "pulse",
  "colors": {
    "background": "#1F1E1D",
    "surface": "#262624",
    "surface-raised": "#2E2C29",
    "text": "#F0EEE6",
    "muted": "#B7B1A5",
    "border": "#3A3A38",
    "border-strong": "#4A4741",
    "accent": "#D97757",
    "accent-fg": "#1F1E1D",
    "link": "#8FB4D9",
    "code-bg": "#1F1E1D",
    "code-fg": "#F0EEE6",
    "quote": "#B7B1A5",
    "danger": "#E08E72",
    "warning": "#EBDBBC",
    "success": "#A3B27A",
    "info": "#8FB4D9",
    "selection": "#3F3B34"
  },
  "radii": {
    "none": 0,
    "sm": 6,
    "md": 8,
    "lg": 10,
    "xl": 14,
    "pill": 999,
    "circle": 9999
  },
  "typography": {
    "family": "Styrene B",
    "stack": "\"Styrene B\", \"Styrene A\", \"Söhne\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, \"Noto Sans\", sans-serif",
    "mono-stack": "\"Berkeley Mono\", \"Söhne Mono\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace",
    "base-size": 17,
    "ui-size": 13,
    "small-size": 11.5,
    "line-height": 1.65,
    "heading-line-height": 1.25,
    "code-line-height": 1.55,
    "weight-normal": 400,
    "weight-bold": 600
  },
  "layout": {
    "content-width": "46rem",
    "sidebar-width": "16rem",
    "scroll-offset": "7rem",
    "article-padding-y": "2.5rem",
    "article-padding-x": "1.25rem",
    "article-padding-bottom": "6rem",
    "control-height": "1.9rem",
    "code-padding": "1em",
    "table-cell-padding": ".4em .75em"
  },
  "effects": {
    "shadow-panel": "0 8px 28px rgba(0,0,0,.5)",
    "overlay": "rgba(0,0,0,.62)",
    "blur": "10px",
    "duration-fast": ".15s",
    "duration-ui": ".2s",
    "easing": "cubic-bezier(.2,.7,.3,1)"
  },
  "charts": {
    "palette": [
      "#D97757",
      "#8FB4D9",
      "#A3B27A",
      "#CC785C",
      "#D4A27F",
      "#C97450",
